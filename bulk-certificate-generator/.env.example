# Copy to .env and adjust as needed. All values are optional.

# SQLAlchemy database URL. When unset, defaults to certificates.db in the project root.
# Note: a relative SQLite path such as sqlite:///./other.db is relative to the directory Uvicorn is started from.
# DATABASE_URL=sqlite:///./certificates.db

# Where generated PDFs are written. Relative paths are resolved against the project root.
CERTIFICATE_OUTPUT_DIR=generated_certificates

# Maximum recipients accepted in one job (larger batches are rejected with 422).
MAX_RECIPIENTS_PER_JOB=500

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Regex of browser origins allowed to call the API (CORS). Default allows any port on localhost/127.0.0.1,
# e.g. the web UI opened through VS Code Live Server (http://127.0.0.1:5500).
# CORS_ALLOW_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
